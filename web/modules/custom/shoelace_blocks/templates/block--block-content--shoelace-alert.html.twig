{#
/**
 * @file
 * Renders a "Shoelace Alert" custom block via the sdc_shoelace:alert component.
 *
 * The view display hides every field; we read raw values from the block_content
 * entity and pass them as props/slots to the SDC component. This is Path A of
 * the editorial-experience integration: editors fill in fields, developers map
 * them to a component once.
 *
 * Available variables (Drupal core):
 * - content: the rendered field children (unused here; we read from the entity).
 * - elements: the renderable array; elements.content['#block_content'] is the entity.
 * - title_prefix: prefix content (includes contextual links for Layout Builder).
 * - title_suffix: suffix content.
 * - attributes: HTML attributes for the container element.
 */
#}
{# Wrap in a container to properly display contextual links #}
<div{{ attributes }}>
  {{ title_prefix }}
  
  {% set block_entity = elements.content['#block_content'] %}
  
  {% set variant = block_entity.field_variant.0.value|default('primary') %}
  {% set icon = block_entity.field_icon.0.value|default('') %}
  {% set closable = block_entity.field_closable.0.value ? true : false %}
  {% set message_value = block_entity.field_message.0.value|default('') %}
  
  {% include 'sdc_shoelace:alert' with {
    variant: variant,
    closable: closable,
    open: true,
    icon: icon,
    content: message_value,
  } only %}
  
  {{ title_suffix }}
</div>
